+from enum import Enum
+
+class RegistryErrorCode(str, Enum):
+    REJECT_CONFLICT = "REJECT_CONFLICT"
+    UNKNOWN_KEY = "UNKNOWN_KEY"
+    INVALID_STATE = "INVALID_STATE"
+    TWO_ACTIVE = "TWO_ACTIVE"
+    MISSING_DSN = "MISSING_DSN"
+
+class RegistryError(Exception):
+    def __init__(self, code: RegistryErrorCode, msg: str):
+        super().__init__(f"[{code}] {msg}")
+        self.code = code
+
+class KeyConflictError(RegistryError):
+    def __init__(self, msg="public key diversa per stesso (node_id,key_id)"):
+        super().__init__(RegistryErrorCode.REJECT_CONFLICT, msg)
+
+class UnknownKeyError(RegistryError):
+    def __init__(self, msg="chiave non trovata"):
+        super().__init__(RegistryErrorCode.UNKNOWN_KEY, msg)
+
+class InvalidStateError(RegistryError):
+    def __init__(self, msg="vecchia chiave non ACTIVE"):
+        super().__init__(RegistryErrorCode.INVALID_STATE, msg)
+
+class TwoActiveError(RegistryError):
+    def __init__(self, msg="due chiavi ACTIVE per stesso nodo impossibili"):
+        super().__init__(RegistryErrorCode.TWO_ACTIVE, msg)
