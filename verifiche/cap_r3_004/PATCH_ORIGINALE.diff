+from typing import Optional, List, Dict
+import threading
+from .store import NodeRegistryStore
+from .errors import KeyConflictError, UnknownKeyError, InvalidStateError, TwoActiveError
+
+class InMemoryNodeRegistry(NodeRegistryStore):
+    def __init__(self, initial_keys: Optional[set] = None):
+        self._store: Dict[tuple, Dict] = {}
+        self._lock = threading.RLock()
+        self._initial = initial_keys or set()
+
+    def _check_two_active(self, node_id: str, exclude_key_id: Optional[str] = None):
+        actives = [v for (n,k), v in self._store.items() if n==node_id and v["status"]=="ACTIVE" and k!=exclude_key_id]
+        if actives:
+            raise TwoActiveError(f"node {node_id} ha gia ACTIVE {actives[0]['key_id']}")
+
+    def register(self, node_id: str, key_id: str, public_key: str) -> Dict:
+        with self._lock:
+            key = (node_id, key_id)
+            if key in self._store:
+                existing = self._store[key]
+                if existing["public_key"] == public_key:
+                    return {"status": "IDEMPOTENT", "record": existing}
+                else:
+                    raise KeyConflictError(f"conflict (node_id={node_id}, key_id={key_id}) public_key diversa")
+            self._check_two_active(node_id)
+            rec = {"node_id": node_id, "key_id": key_id, "public_key": public_key, "status": "ACTIVE"}
+            self._store[key] = rec
+            return {"status": "OK", "record": rec}
+
+    def rotate(self, node_id: str, old_key_id: str, new_key_id: str, new_public_key: str) -> Dict:
+        with self._lock:
+            old_key = (node_id, old_key_id)
+            if old_key not in self._store or self._store[old_key]["status"] != "ACTIVE":
+                raise InvalidStateError(f"old_key {old_key_id} non ACTIVE per nodo {node_id}")
+            new_key = (node_id, new_key_id)
+            if new_key in self._store:
+                if self._store[new_key]["public_key"] != new_public_key:
+                    raise KeyConflictError()
+            self._store[old_key]["status"] = "ROTATED"
+            try:
+                self._check_two_active(node_id, exclude_key_id=old_key_id)
+            except TwoActiveError:
+                self._store[old_key]["status"] = "ACTIVE"
+                raise
+            rec = {"node_id": node_id, "key_id": new_key_id, "public_key": new_public_key, "status": "ACTIVE"}
+            self._store[new_key] = rec
+            return {"status": "ROTATED", "old": old_key_id, "new": rec}
+
+    def revoke(self, node_id: str, key_id: str) -> Dict:
+        with self._lock:
+            key = (node_id, key_id)
+            if key not in self._store:
+                raise UnknownKeyError(f"revoke {node_id}/{key_id} - nessuna riga modificata")
+            del self._store[key]
+            return {"status": "REVOKED"}
+
+    def get_active(self, node_id: str) -> Optional[Dict]:
+        with self._lock:
+            for (n,k), v in self._store.items():
+                if n==node_id and v["status"]=="ACTIVE":
+                    return v
+            return None
+
+    def list_keys(self, node_id: str) -> List[Dict]:
+        with self._lock:
+            return [v for (n,k), v in self._store.items() if n==node_id]
