+from typing import Optional
+from .store import NodeRegistryStore
+from .in_memory import InMemoryNodeRegistry
+from .postgres import PostgreSQLNodeRegistry
+import os
+
+class FabricNode:
+    """
+    CAP-R3-004: FabricNode dipende da NodeRegistryStore, non istanzia direttamente PG o InMemory.
+    Supporta R3-PEER/1.1c: ChannelRegistry, observed vs canonical head, provref opaco.
+    """
+    def __init__(self, node_id: str, registry_store: NodeRegistryStore, backup_store=None, channel_registry=None):
+        self.node_id = node_id
+        self.registry: NodeRegistryStore = registry_store
+        self.backup_store = backup_store
+        self.channel_registry = channel_registry
+        # R3-PEER: provref opaco - mapping solo in secret store
+        self.provider_account_ref = os.getenv("PROVIDER_ACCOUNT_REF")  # deve essere provref:...
+
+    def register_key(self, key_id: str, public_key: str):
+        return self.registry.register(self.node_id, key_id, public_key)
+
+    def rotate_key(self, old_key_id: str, new_key_id: str, new_public_key: str):
+        res = self.registry.rotate(self.node_id, old_key_id, new_key_id, new_public_key)
+        if self.backup_store:
+            self.backup_store.snapshot(self.node_id, res["new"])
+        return res
+
+    def revoke_key(self, key_id: str):
+        return self.registry.revoke(self.node_id, key_id)
+
+    def get_active(self):
+        return self.registry.get_active(self.node_id)
+
+    @staticmethod
+    def from_env(node_id: str) -> "FabricNode":
+        # Factory che rispetta R3-PEER + CAP-R3-004: ENV non hardcodato
+        dsn = os.getenv("NODE_REGISTRY_DSN")
+        if dsn:
+            store = PostgreSQLNodeRegistry(dsn=dsn)
+        else:
+            store = InMemoryNodeRegistry()
+        return FabricNode(node_id=node_id, registry_store=store)
