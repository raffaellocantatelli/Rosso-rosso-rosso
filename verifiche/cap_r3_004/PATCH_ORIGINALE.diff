+import threading
+from cap_r3_004.in_memory import InMemoryNodeRegistry
+from cap_r3_004.postgres import PostgreSQLNodeRegistry
+from cap_r3_004.errors import InvalidStateError, TwoActiveError
+
+def run_double_rotation(store):
+    store.register("node-conc", "k1", "pub1")
+    results = []
+    def attempt(new_id):
+        try:
+            r = store.rotate("node-conc", "k1", new_id, f"pub-{new_id}")
+            results.append(("OK", new_id))
+        except (InvalidStateError, TwoActiveError) as e:
+            results.append(("FAIL", new_id, str(e.code)))
+
+    t1 = threading.Thread(target=attempt, args=("k2",))
+    t2 = threading.Thread(target=attempt, args=("k3",))
+    t1.start()
+    t2.start()
+    t1.join()
+    t2.join()
+    ok = [x for x in results if x[0]=="OK"]
+    fail = [x for x in results if x[0]=="FAIL"]
+    assert len(ok)==1, f"expected 1 OK got {results}"
+    assert len(fail)==1
+    active = store.get_active("node-conc")
+    assert active["key_id"] in ("k2","k3")
+    all_keys = store.list_keys("node-conc")
+    actives = [k for k in all_keys if k["status"]=="ACTIVE"]
+    assert len(actives)==1
+
+def test_double_rotation_inmemory():
+    run_double_rotation(InMemoryNodeRegistry())
+
+def test_double_rotation_postgres_sim():
+    run_double_rotation(PostgreSQLNodeRegistry(dsn=None, use_real_db=False))
