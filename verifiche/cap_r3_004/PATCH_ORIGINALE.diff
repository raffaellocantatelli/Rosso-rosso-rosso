+import pytest
+from cap_r3_004.in_memory import InMemoryNodeRegistry
+from cap_r3_004.postgres import PostgreSQLNodeRegistry
+from cap_r3_004.errors import KeyConflictError, UnknownKeyError, TwoActiveError, InvalidStateError
+from cap_r3_004.fabric_node import FabricNode
+
+def get_stores():
+    return [InMemoryNodeRegistry(), PostgreSQLNodeRegistry(dsn=None, use_real_db=False)]
+
+@pytest.mark.parametrize("store", get_stores())
+def test_register_same_key_id_same_key_is_idempotent(store):
+    r1 = store.register("nodeA", "k1", "pub1")
+    assert r1["status"] in ("OK","IDEMPOTENT")
+    r2 = store.register("nodeA", "k1", "pub1")
+    assert r2["status"] == "IDEMPOTENT"
+
+@pytest.mark.parametrize("store", get_stores())
+def test_register_same_key_id_different_key_rejects_conflict(store):
+    store.register("nodeB", "k1", "pub1")
+    with pytest.raises(KeyConflictError) as exc:
+        store.register("nodeB", "k1", "pub-different")
+    assert exc.value.code.value == "REJECT_CONFLICT"
+
+@pytest.mark.parametrize("store", get_stores())
+def test_two_active_keys_impossible(store):
+    store.register("nodeC", "k1", "pub1")
+    with pytest.raises(TwoActiveError):
+        store.register("nodeC", "k2", "pub2")
+
+@pytest.mark.parametrize("store", get_stores())
+def test_revoke_unknown_key_returns_error(store):
+    with pytest.raises(UnknownKeyError) as exc:
+        store.revoke("nodeX", "nonexistent")
+    assert exc.value.code.value == "UNKNOWN_KEY"
+
+@pytest.mark.parametrize("store", get_stores())
+def test_rotate_verifies_old_active(store):
+    store.register("nodeD", "k1", "pub1")
+    with pytest.raises(InvalidStateError):
+        store.rotate("nodeD", "k-wrong", "k2", "pub2")
+    res = store.rotate("nodeD", "k1", "k2", "pub2")
+    assert res["status"] == "ROTATED"
+    assert store.get_active("nodeD")["key_id"] == "k2"
+    with pytest.raises(InvalidStateError):
+        store.rotate("nodeD", "k1", "k3", "pub3")
+
+@pytest.mark.parametrize("store", get_stores())
+def test_fabric_registry_integration(store):
+    node = FabricNode(node_id="fabric-1", registry_store=store)
+    node.register_key("k1", "pub1")
+    assert node.get_active()["key_id"] == "k1"
