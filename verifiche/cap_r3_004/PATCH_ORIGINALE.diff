+import os
+from typing import Optional, List, Dict
+from .store import NodeRegistryStore
+from .errors import RegistryErrorCode, KeyConflictError, UnknownKeyError, InvalidStateError, TwoActiveError, RegistryError
+
+DDL = """
+CREATE TABLE IF NOT EXISTS node_keys (
+  node_id TEXT NOT NULL,
+  key_id TEXT NOT NULL,
+  public_key TEXT NOT NULL,
+  status TEXT NOT NULL CHECK (status IN ('ACTIVE','ROTATED','REVOKED')),
+  PRIMARY KEY (node_id, key_id)
+);
+CREATE UNIQUE INDEX IF NOT EXISTS uniq_active_node ON node_keys(node_id) WHERE status='ACTIVE';
+"""
+
+class PostgreSQLNodeRegistry(NodeRegistryStore):
+    def __init__(self, dsn: Optional[str] = None, use_real_db: Optional[bool] = None):
+        self.dsn = dsn or os.getenv("NODE_REGISTRY_DSN")
+        if not self.dsn and (use_real_db is True):
+            raise RegistryError(RegistryErrorCode.MISSING_DSN, "NODE_REGISTRY_DSN mancante")
+        self._mem = {}
+        self._real_conn = None
+        self._use_real = False
+        if self.dsn and use_real_db is not False:
+            try:
+                import psycopg
+                self._real_conn = psycopg.connect(self.dsn)
+                self._real_conn.autocommit = False
+                with self._real_conn.cursor() as cur:
+                    cur.execute(DDL)
+                self._real_conn.commit()
+                self._use_real = True
+            except Exception as e:
+                self._use_real = False
+                self._real_error = str(e)
+
+    def register(self, node_id: str, key_id: str, public_key: str) -> Dict:
+        if self._use_real:
+            import psycopg
+            try:
+                with self._real_conn.cursor() as cur:
+                    cur.execute("SELECT public_key, status FROM node_keys WHERE node_id=%s AND key_id=%s", (node_id, key_id))
+                    row = cur.fetchone()
+                    if row:
+                        if row[0] == public_key:
+                            self._real_conn.commit()
+                            return {"status": "IDEMPOTENT", "record": {"node_id": node_id, "key_id": key_id, "public_key": public_key, "status": row[1]}}
+                        else:
+                            self._real_conn.rollback()
+                            raise KeyConflictError()
+                    cur.execute("INSERT INTO node_keys(node_id,key_id,public_key,status) VALUES (%s,%s,%s,'ACTIVE')", (node_id,key_id,public_key))
+                self._real_conn.commit()
+                return {"status": "OK", "record": {"node_id": node_id, "key_id": key_id, "public_key": public_key, "status": "ACTIVE"}}
+            except psycopg.errors.UniqueViolation as e:
+                self._real_conn.rollback()
+                if "uniq_active_node" in str(e):
+                    raise TwoActiveError()
+                raise KeyConflictError()
+        else:
+            key = (node_id, key_id)
+            if key in self._mem:
+                if self._mem[key]["public_key"] == public_key:
+                    return {"status": "IDEMPOTENT", "record": self._mem[key]}
+                raise KeyConflictError()
+            for (n,k), v in self._mem.items():
+                if n==node_id and v["status"]=="ACTIVE":
+                    raise TwoActiveError()
+            rec = {"node_id": node_id, "key_id": key_id, "public_key": public_key, "status": "ACTIVE"}
+            self._mem[key]=rec
+            return {"status":"OK","record":rec}
+
+    def rotate(self, node_id: str, old_key_id: str, new_key_id: str, new_public_key: str) -> Dict:
+        if self._use_real:
+            import psycopg
+            with self._real_conn.cursor() as cur:
+                cur.execute("SELECT status FROM node_keys WHERE node_id=%s AND key_id=%s FOR UPDATE", (node_id, old_key_id))
+                row = cur.fetchone()
+                if not row or row[0] != "ACTIVE":
+                    self._real_conn.rollback()
+                    raise InvalidStateError()
+                cur.execute("UPDATE node_keys SET status='ROTATED' WHERE node_id=%s AND key_id=%s", (node_id, old_key_id))
+                try:
+                    cur.execute("INSERT INTO node_keys(node_id,key_id,public_key,status) VALUES (%s,%s,%s,'ACTIVE') ON CONFLICT (node_id,key_id) DO NOTHING", (node_id,new_key_id,new_public_key))
+                    cur.execute("SELECT public_key FROM node_keys WHERE node_id=%s AND key_id=%s", (node_id,new_key_id))
+                    r2 = cur.fetchone()
+                    if r2 and r2[0] != new_public_key:
+                        self._real_conn.rollback()
+                        raise KeyConflictError()
+                except psycopg.errors.UniqueViolation:
+                    self._real_conn.rollback()
+                    raise TwoActiveError()
+            self._real_conn.commit()
+            return {"status":"ROTATED","old":old_key_id,"new":{"node_id":node_id,"key_id":new_key_id,"public_key":new_public_key,"status":"ACTIVE"}}
+        else:
+            old = (node_id, old_key_id)
+            if old not in self._mem or self._mem[old]["status"]!="ACTIVE":
+                raise InvalidStateError()
+            new = (node_id, new_key_id)
+            if new in self._mem and self._mem[new]["public_key"]!=new_public_key:
+                raise KeyConflictError()
+            self._mem[old]["status"]="ROTATED"
+            for (n,k), v in list(self._mem.items()):
+                if n==node_id and k!=old_key_id and k!=new_key_id and v["status"]=="ACTIVE":
+                    self._mem[old]["status"]="ACTIVE"
+                    raise TwoActiveError()
+            rec = {"node_id":node_id,"key_id":new_key_id,"public_key":new_public_key,"status":"ACTIVE"}
+            self._mem[new]=rec
+            return {"status":"ROTATED","old":old_key_id,"new":rec}
+
+    def revoke(self, node_id: str, key_id: str) -> Dict:
+        if self._use_real:
+            with self._real_conn.cursor() as cur:
+                cur.execute("DELETE FROM node_keys WHERE node_id=%s AND key_id=%s", (node_id,key_id))
+                if cur.rowcount==0:
+                    self._real_conn.rollback()
+                    raise UnknownKeyError()
+            self._real_conn.commit()
+            return {"status":"REVOKED"}
+        else:
+            key=(node_id,key_id)
+            if key not in self._mem:
+                raise UnknownKeyError()
+            del self._mem[key]
+            return {"status":"REVOKED"}
+
+    def get_active(self, node_id: str) -> Optional[Dict]:
+        if self._use_real:
+            with self._real_conn.cursor() as cur:
+                cur.execute("SELECT node_id,key_id,public_key,status FROM node_keys WHERE node_id=%s AND status='ACTIVE' LIMIT 1", (node_id,))
+                row=cur.fetchone()
+                if not row:
+                    return None
+                return {"node_id":row[0],"key_id":row[1],"public_key":row[2],"status":row[3]}
+        else:
+            for (n,k), v in self._mem.items():
+                if n==node_id and v["status"]=="ACTIVE":
+                    return v
+            return None
+
+    def list_keys(self, node_id: str) -> List[Dict]:
+        if self._use_real:
+            with self._real_conn.cursor() as cur:
+                cur.execute("SELECT node_id,key_id,public_key,status FROM node_keys WHERE node_id=%s", (node_id,))
+                return [{"node_id":r[0],"key_id":r[1],"public_key":r[2],"status":r[3]} for r in cur.fetchall()]
+        else:
+            return [v for (n,k), v in self._mem.items() if n==node_id]
