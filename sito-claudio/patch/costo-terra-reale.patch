+def _intervallo_totale(m: MetaPossibile) -> tuple[float, float]:
+    """Estremi del totale: navetta prenotata presto, oppure a tariffa piena.
+
+    Per gli aeroporti non censiti in TRASFERIMENTI_NOTI i due estremi
+    coincidono con il totale: non sappiamo di più.
+    """
+    noto = TRASFERIMENTI_NOTI.get(m.da)
+    if noto is None:
+        return (m.totale, m.totale)
+    minimo, standard = noto
+    base = m.totale - m.costo_terra
+    return (round(base + minimo, 2), round(base + standard, 2))
+
+
+def _prezzo_testo(m: MetaPossibile) -> str:
+    """Il totale, come intervallo quando la navetta ha due tariffe note.
+
+    Dire «23€» quando la stessa navetta costa fra 13,90 e 19 a seconda di
+    quando la prenoti è la stessa omissione che questo strumento denuncia.
+    """
+    basso, alto = _intervallo_totale(m)
+    if round(basso) == round(alto):
+        return f"{basso:.0f}€"
+    return f"{basso:.0f}–{alto:.0f}€ secondo quando prenoti la navetta"
+
