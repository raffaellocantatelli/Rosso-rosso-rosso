# Token del bot, da @BotFather. Senza questo il bot non parte (codice 2).
TELEGRAM_BOT_TOKEN=

# Percorso del database SQLite (default: protocollo.db nella cartella corrente)
PROTOCOLLO_DB=protocollo.db

# Durata minima, in secondi, perche' il gesto della candela sia registrato
# come gesto lento. Abbassarla non rende il gesto piu' lento: rende il dato
# meno vero.
PROTOCOLLO_GESTO_MIN=20

# Livello di log (DEBUG, INFO, WARNING)
PROTOCOLLO_LOG=INFO
