+        )
         logger.info(f"FIRMS country enrichment: +{len(new_fires)} fires from {len(_FIRMS_COUNTRIES)} countries")
         _mark_fresh("firms_fires")
     else:
diff --git a/backend/services/slo.py b/backend/services/slo.py
index ee6db9a..720089c 100644
--- a/backend/services/slo.py
+++ b/backend/services/slo.py
@@ -5,6 +5,18 @@ endpoint uses to compute red/yellow/green status and that fetchers use
 as canary thresholds — the early-warning signal that an upstream source
 structure has silently broken.
 
+Two failure modes are tracked, and they are mirror images:
+
+* **silent zero** — a source stops flowing and reports 0 rows, which reads
+  as "nothing happened" rather than "nothing arrived" (``empty``);
+* **silent ceiling** — a source is capped for payload or render budget and
+  reports the cap, which reads as a measurement rather than a lower bound
+  (``truncated``).
+
+Both make a number on the dashboard mean something it does not mean. A
+fetcher that caps calls ``_mark_total(source, upstream_count)`` so the real
+figure survives, and ``compute_status`` flags the row as truncated.
+
 A human operator cannot reliably monitor 30+ layers for "is this still
 flowing?". This registry is the automated check that does it for them.
 
@@ -151,11 +163,17 @@ def compute_status(
     source: str,
     row_count: int,
     last_fresh_iso: Optional[str],
+    total_rows: Optional[int] = None,
 ) -> Dict[str, Any]:
     """Compute the red/yellow/green status for one source.
 
+    `total_rows` is the upstream count recorded by a capping fetcher via
+    ``_mark_total``. When it exceeds `row_count` the row is marked
+    ``truncated``: `row_count` is then a floor, not a measurement.
+
     Returns a dict with keys: source, status, age_s, row_count, slo,
-    stale, empty, description.
+    stale, empty, description — plus total_rows and truncated when the
+    source records a pre-cap total.
 
     Status codes:
         green         — within SLO on both age and volume
@@ -163,19 +181,26 @@ def compute_status(
         red           — both SLOs violated OR never fetched
         unconfigured  — no SLO registered for this source
     """
+    def _with_cap(entry: Dict[str, Any]) -> Dict[str, Any]:
+        """Attach truncation facts, when the fetcher recorded a pre-cap total."""
+        if total_rows is not None:
+            entry["total_rows"] = total_rows
+            entry["truncated"] = total_rows > row_count
+        return entry
+
     slo = SLO_REGISTRY.get(source)
     if slo is None:
-        return {
+        return _with_cap({
             "source": source,
             "status": "unconfigured",
             "row_count": row_count,
-        }
+        })
 
     last_fresh = _parse_iso(last_fresh_iso)
     now = datetime.utcnow()
 
     if last_fresh is None:
-        return {
+        return _with_cap({
             "source": source,
             "status": "red",
             "age_s": None,
@@ -185,7 +210,7 @@ def compute_status(
             "empty": (slo.min_rows is not None and row_count < slo.min_rows),
             "never_fetched": True,
             "description": slo.description,
-        }
+        })
 
     age_s = max(0.0, (now - last_fresh).total_seconds())
     stale = age_s > slo.max_age_s
@@ -198,7 +223,7 @@ def compute_status(
     else:
         status = "green"
 
-    return {
+    return _with_cap({
         "source": source,
         "status": status,
         "age_s": round(age_s),
@@ -207,19 +232,23 @@ def compute_status(
         "stale": stale,
         "empty": empty,
         "description": slo.description,
-    }
+    })
 
 
 def compute_all_statuses(
     latest_data: Dict[str, Any],
     source_timestamps: Dict[str, str],
+    source_totals: Optional[Dict[str, int]] = None,
 ) -> Dict[str, Dict[str, Any]]:
     """Compute status for every source in the SLO registry.
 
     `latest_data` is the shared dashboard store (or any dict-like with
     the same keys). `source_timestamps` is the per-source fresh-mark
-    dict from services.fetchers._store.
+    dict from services.fetchers._store. `source_totals` is the optional
+    pre-cap row count dict from the same module; sources absent from it
+    are simply not checked for truncation.
     """
+    totals = source_totals or {}
     out: Dict[str, Dict[str, Any]] = {}
     for source in SLO_REGISTRY:
         value = latest_data.get(source)
@@ -227,7 +256,9 @@ def compute_all_statuses(
             count = len(value)
         else:
             count = 0
-        out[source] = compute_status(source, count, source_timestamps.get(source))
+        out[source] = compute_status(
+            source, count, source_timestamps.get(source), totals.get(source)
+        )
     return out
 
 
diff --git a/backend/tests/test_slo_truncation.py b/backend/tests/test_slo_truncation.py
new file mode 100644
index 0000000..243dfc8
--- /dev/null
+++ b/backend/tests/test_slo_truncation.py
@@ -0,0 +1,75 @@
+"""SLO truncation flag — the mirror case of the silent-zero canary.
+
+A capped fetcher stores the cap. Downstream, ``len(latest_data[source])``
+returns that cap and is indistinguishable from a real measurement: the
+dashboard shows a number that reads as "this many exist" when it means
+"at least this many exist". These tests pin the behaviour that keeps the
+two apart.
+"""
+
+import pytest
+
+from services import slo
+
+
+class TestComputeStatusTruncation:
+    def test_truncated_when_upstream_exceeds_stored(self):
+        entry = slo.compute_status(
+            "firms_fires", row_count=5000, last_fresh_iso=None, total_rows=41234
+        )
+        assert entry["total_rows"] == 41234
+        assert entry["truncated"] is True
+        # the stored count is still reported verbatim: it is a floor, not a lie
+        assert entry["row_count"] == 5000
+
+    def test_not_truncated_when_all_rows_stored(self):
+        entry = slo.compute_status(
+            "firms_fires", row_count=812, last_fresh_iso=None, total_rows=812
+        )
+        assert entry["truncated"] is False
+        assert entry["total_rows"] == 812
+
+    def test_absent_when_fetcher_records_no_total(self):
+        """A source that never caps must not sprout a misleading truncated=False."""
+        entry = slo.compute_status("firms_fires", row_count=812, last_fresh_iso=None)
+        assert "truncated" not in entry
+        assert "total_rows" not in entry
+
+    def test_unconfigured_source_still_reports_truncation(self):
+        entry = slo.compute_status(
+            "not_in_registry", row_count=100, last_fresh_iso=None, total_rows=999
+        )
+        assert entry["status"] == "unconfigured"
+        assert entry["truncated"] is True
+
+
+class TestComputeAllStatuses:
+    def test_totals_are_threaded_through(self):
+        source = next(iter(slo.SLO_REGISTRY))
+        statuses = slo.compute_all_statuses(
+            {source: [{}] * 10}, {}, {source: 7000}
+        )
+        assert statuses[source]["truncated"] is True
+        assert statuses[source]["total_rows"] == 7000
+
+    def test_totals_argument_is_optional(self):
+        """Existing callers pass two arguments; that must keep working."""
+        source = next(iter(slo.SLO_REGISTRY))
+        statuses = slo.compute_all_statuses({source: [{}] * 10}, {})
+        assert "truncated" not in statuses[source]
+
+
+class TestStoreMarkTotal:
+    def test_mark_total_round_trips(self):
+        from services.fetchers import _store
+
+        _store._mark_total("firms_fires", 41234)
+        assert _store.get_source_totals_snapshot()["firms_fires"] == 41234
+
+    def test_snapshot_is_a_copy(self):
+        from services.fetchers import _store
+
+        _store._mark_total("firms_fires", 10)
+        snap = _store.get_source_totals_snapshot()
+        snap["firms_fires"] = 999
+        assert _store.get_source_totals_snapshot()["firms_fires"] == 10
