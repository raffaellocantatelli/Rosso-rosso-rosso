diff --git a/backend/services/fetchers/_store.py b/backend/services/fetchers/_store.py
index 20a9c43..2659260 100644
--- a/backend/services/fetchers/_store.py
+++ b/backend/services/fetchers/_store.py
@@ -143,6 +143,14 @@ latest_data: DashboardData = {
 # Per-source freshness timestamps
 source_timestamps = {}
 
+# Per-source pre-cap row counts.
+#
+# Several fetchers cap what they store (payload size, render budget). Once
+# capped, ``len(latest_data[source])`` reports the cap, not the measurement,
+# and downstream consumers cannot tell the two apart. A fetcher that caps
+# records the upstream total here so the SLO layer can flag it as truncated.
+source_totals: dict[str, int] = {}
+
 # Per-source health/freshness metadata (last ok/error)
 source_freshness: dict[str, dict] = {}
 
@@ -443,6 +451,21 @@ def get_latest_data_refs_snapshot() -> DashboardData:
         return {key: value for key, value in latest_data.items()}
 
 
+def _mark_total(source: str, total: int) -> None:
+    """Record the upstream row count a fetcher saw *before* applying its cap.
+
+    Call this in any fetcher that truncates, passing the full count. Without
+    it a capped list is indistinguishable from a complete one.
+    """
+    with _data_lock:
+        source_totals[source] = int(total)
+
+
+def get_source_totals_snapshot() -> dict[str, int]:
+    with _data_lock:
+        return dict(source_totals)
+
+
 def get_source_timestamps_snapshot() -> dict[str, str]:
     """Return a stable copy of per-source freshness timestamps."""
     with _data_lock:
